# Vertex Pro local runtime
VERTEX_PRO_DATABASE=vertex-pro.db
VERTEX_PRO_SNAPSHOT_ROOT=vertex-pro-snapshots

# Optional qui integration. Leave VERTEX_PRO_QUI_URL empty to keep the runtime local-only.
VERTEX_PRO_QUI_URL=
VERTEX_PRO_QUI_INSTANCE_ID=
VERTEX_PRO_QUI_API_KEY=
VERTEX_PRO_QUI_PROXY_KEY=

# Mutation remains disabled by default. Setting this true still fails closed while
# the probed qB Profile is EXPECTED rather than VERIFIED.
VERTEX_PRO_ENABLE_DISPATCH=false

# Optional local-only operator device/mount evidence used by tools/qustorageprobe.
# Keep the referenced file outside the repository and restrict its filesystem ACL.
VERTEX_PRO_STORAGE_EVIDENCE_FILE=
